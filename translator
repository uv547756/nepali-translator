#!/usr/bin/env bash
# Wrapper that activates the venv automatically before running the server.
# Usage: ./translator [--mode server|offline] [options]
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$REPO_ROOT/.venv"

if [ ! -f "$VENV/bin/activate" ]; then
    echo "ERROR: venv not found at $VENV — run: bash scripts/setup.sh" >&2
    exit 1
fi

source "$VENV/bin/activate"
exec python -m server.main "$@"
